/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "remote-mcp-server-authless",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"vars": {
		"META_REVIEW_ENABLED": "true",
		"META_REVIEW_TELEGRAM_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "PCC_CFO_DB",
			"database_name": "pcc-ai-cfo-ua",
			"database_id": "aeed7e9d-2afe-48c5-a484-a7fad389198a"
		},
		{
			"binding": "META_REVIEW_DB",
			"database_name": "pcc-meta-reviewer",
			"database_id": "2e906996-8722-42a7-8dd6-266fe5df2644"
		}
	],
	"triggers": {
		"crons": [
			"0 18 * * SUN",
			"0 19 * * SUN",
			"0 6 * * MON",
			"0 7 * * MON"
		]
	},
	"observability": {
		"enabled": true
	}
}
